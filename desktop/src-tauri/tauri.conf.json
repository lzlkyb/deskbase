{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "deskbase",
  "version": "0.1.1",
  "identifier": "com.example.deskbase",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Deskbase",
        "width": 1280,
        "height": 840,
        "minWidth": 560,
        "minHeight": 600,
        "decorations": false,
        "visible": false,
        "center": true,
        "resizable": true,
        "backgroundColor": "#F4F6F9"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://lzlkyb.github.io/deskbase/updater.json",
        "https://github.com/lzlkyb/deskbase/releases/latest/download/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1QkQ4MkUxMTlEQjZDRDkKUldUWmJOc1o0WUs5VmF6bmdUSVh3SnRuUUpNWGRyc1FJc0F1QU1ISHpuNjFqMVRaNXVENFRMMS8K",
      "windows": {},
      "dangerousInsecureTransportProtocol": true,
      "active": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
